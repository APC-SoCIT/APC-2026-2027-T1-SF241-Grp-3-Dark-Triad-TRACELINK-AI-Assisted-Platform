@startuml TraceLink-UCD-V3
left to right direction
actor "SEO Specialist" as SEO
actor "System Administrator" as Admin
rectangle "TraceLink System" {
    usecase "Manage Account" as UC1
    usecase "Upload Bulk URL Lists" as UC2
    usecase "Initiate Batch Scan" as UC3
    usecase "Manage Cache Operations" as UC4
    usecase "Check Stored Data Integrity" as UC5
    usecase "Monitor Scan Progress" as UC6
    usecase "Review Dashboard Results" as UC7
    usecase "Review System and Activity Logs" as UC8
    usecase "Monitor System Operations and AI Usage" as UC9

    'Include and Extends Sub Use Cases
    usecase "Extract and Normalize URLs" as I1
    usecase "Detect Duplicate URLs" as I2
    usecase "Validate Technical URLs" as I3
    usecase "Analyze Webpage Content" as I4
    usecase "Run AI Content Evaluation" as I5
    usecase "Reuse Fresh Cached Results" as I6
    usecase "Refresh Stale Cached Data" as E1
    usecase "Search & Filter Scan Results" as I7
    usecase "Perform Manual Review & Override Flags" as E2
    usecase "Export Processed Results" as I8

    'Relationships
    SEO --> UC1
    SEO --> UC2
    SEO --> UC3
    SEO --> UC4
    Admin --> UC1
    Admin --> UC5
    SEO --> UC6
    SEO --> UC7
    Admin --> UC8
    Admin --> UC9

    'Include and Extends Relationships
    UC2 ..> I1 : <<include>>
    UC2 ..> I2 : <<include>>
    UC3 ..> I3 : <<include>>
    UC3 ..> I4 : <<include>>
    UC3 ..> I5 : <<include>>
    UC4 ..> I6 : <<include>>
    UC4 <.. E1 : <<extends>>
    UC7 ..> I7 : <<include>>
    UC7 <.. E2 : <<extends>>
    UC7 ..> I8 : <<include>>
}
@enduml