//UCD using Graphviz
digraph TraceLink_UCD_Simple_Ver {
    rankdir=LR;
    node [shape=ellipse, style=filled, fillcolor=white, fontname="Arial"];
    node [shape=box, style="filled,rounded", fillcolor=lightgray];
    SEO [label="👤 SEO Specialist"];
    Admin [label="👤 System Administrator"];
    node [shape=ellipse, style=filled, fillcolor=white];
    UC1 [label="Manage Account"];
    UC2 [label="Upload URL File"];
    UC3 [label="Initiate Batch Scan"];
    UC4 [label="Verify Stored Data Integrity"];
	I1 [label="Extract and Parse URLs"];
	I2 [label="Check Cached Results"];
	I3 [label="Validate HTTP Status"];
	I4 [label="Parse DOM & Detect Interactions"];
	I5 [label="Evaluate Content via AI"];
	E1 [label="Refresh Expired Cache Data"];
	E2 [label="Track Redirects and Access Errors"];
	E3 [label="Flag Low-Quality / Spam Pages"];
	
	SEO -> UC1
	SEO -> UC2
	SEO -> UC3
	Admin -> UC1
	Admin -> UC4

	UC2 -> I1 [style=dashed, label="<<include>>"];
	UC3 -> I2 [style=dashed, label="<<include>>"];
	UC3 -> I3 [style=dashed, label="<<include>>"];
	UC3 -> I4 [style=dashed, label="<<include>>"];
	UC3 -> I5 [style=dashed, label="<<include>>"];
	UC3 -> E1 [style=dashed, label="<<extend>>"];
	UC3 -> E2 [style=dashed, label="<<extend>>"];
	UC3 -> E3 [style=dashed, label="<<extend>>"];
}