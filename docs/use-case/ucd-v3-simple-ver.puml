@startuml TraceLink-UCD-V3
left to right direction
actor "SEO Specialist" as SEO
actor "System Administrator" as Admin
rectangle "TraceLink System" {
    usecase "Manage Account" as UC1
    usecase "Upload Bulk URL Lists" as UC2
    usecase "Initiate Batch Scan" as UC3
    usecase "Manage Cache Operations" as UC4
    usecase "Check Stored Data Integrity" as UC5
    usecase "Monitor Scan Progress" as UC6
    usecase "Review Dashboard Results" as UC7
    usecase "Review System and Activity Logs" as UC8
    usecase "Monitor System Operations and AI Usage" as UC9
    SEO --> UC1
    SEO --> UC2
    SEO --> UC3
    SEO --> UC4
    Admin --> UC1
    Admin --> UC5
    SEO --> UC6
    SEO --> UC7
    Admin --> UC8
    Admin --> UC9
@enduml