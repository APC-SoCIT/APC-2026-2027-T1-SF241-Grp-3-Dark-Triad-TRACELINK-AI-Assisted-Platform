@startuml TraceLink_Container_Diagram
!include http://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()
LAYOUT_LEFT_RIGHT()

title Container Diagram - TraceLink

Person(seo, "SEO Specialist", "Uploads and reviews URL scans")
Person(admin, "System Administrator", "Monitors system integrity")

System_Boundary(tracelink, "TraceLink") {
    Container(webapp, "Web Application", "React (SPA)", "Lets users upload URL datasets, set evaluation criteria, view dashboards, and export reports")
    Container(api, "API Application", "", "Validates uploads, cleans and normalizes URLs, detects duplicates, and orchestrates processing jobs")
    ContainerQueue(queue, "Task Queue", "", "Holds validation jobs so URLs can be processed asynchronously instead of one at a time")
    Container(worker, "Worker Service", "", "Validates URL status, analyzes webpage structure, and runs AI-assisted content evaluation")
    ContainerDb(db, "Database", "", "Stores jobs, normalized URLs, validation results, extracted page elements, AI classifications, and cache/fingerprint records")
}

System_Ext(websites, "Target Websites", "The external URLs being validated")
System_Ext(ai, "AI Model Provider", "e.g. Gemini API - performs content relevance/quality classification")

Rel(seo, webapp, "Uses", "HTTPS")
Rel(admin, webapp, "Uses", "HTTPS")
Rel(webapp, api, "Makes API calls to", "HTTPS/JSON")
Rel(api, queue, "Publishes validation jobs to")
Rel(queue, worker, "Delivers jobs to")
Rel(api, db, "Reads from and writes to")
Rel(worker, db, "Reads from and writes to")
Rel(worker, websites, "Sends validation requests to", "HTTPS")
Rel(worker, ai, "Sends page content for evaluation to", "HTTPS/JSON")

@enduml
