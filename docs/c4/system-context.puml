@startuml TraceLink_System_Context

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_TOP_DOWN()

title System Context Diagram - TraceLink

Person(seoSpecialist, "SEO Specialist", "Performs URL validation and webpage-content review for SEO work.")
Person(workspaceOwner, "Workspace Owner / Team Administrator", "Coordinates shared TraceLink work and manages workspace access.")
Person(systemAdmin, "System Administrator", "Manages platform-wide access, configuration, and administrative controls.")
Person(supportStaff, "Operations / Support Staff", "Supports users and investigates authorized operational issues.")
Person(platformOperator, "Project Team / Platform Operator", "Operates, monitors, and improves the TraceLink service.")

System(tracelink, "TraceLink", "Cloud-based platform for bounded SEO URL validation and web content analysis.")

System_Ext(targetWebsites, "Target Websites", "External webpages processed for technical validation and accessible content retrieval.")
System_Ext(aiService, "External AI Service", "Provides AI-assisted evaluation of prepared webpage content.")

BiRel(seoSpecialist, tracelink, "Submits URL batches and review actions;\nreceives scan results and reports", "HTTPS")
BiRel(workspaceOwner, tracelink, "Manages shared work and permissions;\nreceives workspace and scan information", "HTTPS")
BiRel(systemAdmin, tracelink, "Performs administrative actions;\nreceives platform and integrity information", "HTTPS")
BiRel(supportStaff, tracelink, "Performs support and diagnostic actions;\nreceives ticket and failure information", "HTTPS")
BiRel(platformOperator, tracelink, "Performs operational actions;\nreceives health and performance information", "HTTPS")

BiRel(tracelink, targetWebsites, "Sends controlled requests;\nreceives responses and accessible content", "HTTP/HTTPS")
BiRel(tracelink, aiService, "Sends prepared content and criteria;\nreceives structured evaluation", "HTTPS / API")

' Compact placement
Lay_R(seoSpecialist, workspaceOwner)
Lay_R(workspaceOwner, systemAdmin)
Lay_R(systemAdmin, supportStaff)
Lay_R(supportStaff, platformOperator)

Lay_D(systemAdmin, tracelink)

Lay_R(targetWebsites, aiService)
Lay_D(tracelink, targetWebsites)

SHOW_LEGEND()

@enduml