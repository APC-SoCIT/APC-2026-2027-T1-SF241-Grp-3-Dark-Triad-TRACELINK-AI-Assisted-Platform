@startuml TraceLink_System_Context

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_LEFT_RIGHT()

title System Context Diagram - TraceLink

Person(seoSpecialist, "SEO Specialist", "Uploads URL datasets, runs scans, reviews results, and uses SEO analysis reports.")

Person(systemAdmin, "System Administrator", "Manages users, monitors operations and logs, and maintains platform reliability.")

System(traceLink, "TraceLink", "Automates bulk URL validation, webpage analysis, AI-assisted content evaluation, and result reporting.")

System_Ext(externalWebsites, "External Websites", "Public webpages accessed by TraceLink for URL validation and content analysis.")

System_Ext(aiService, "AI Service", "Evaluates webpage content for relevance and quality.")

Rel(seoSpecialist, traceLink, "Uploads batches, runs scans, and reviews results", "HTTPS")

Rel(systemAdmin, traceLink, "Manages users and monitors system operations", "HTTPS")

Rel(traceLink, externalWebsites, "Validates URLs and retrieves webpage content", "HTTPS")

Rel(traceLink, aiService, "Requests content evaluation", "HTTPS / API")

SHOW_LEGEND()

@enduml