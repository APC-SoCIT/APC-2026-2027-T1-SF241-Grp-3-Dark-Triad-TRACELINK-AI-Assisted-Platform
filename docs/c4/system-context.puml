@startuml TraceLink_System_Context

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_LEFT_RIGHT()

title System Context Diagram - TraceLink

Person(seoSpecialist, "SEO Specialist", "Uploads URL datasets, initiates scans, monitors progress, reviews results, performs manual review, and exports processed results.")

Person(systemAdmin, "System Administrator", "Manages user accounts, checks data integrity, reviews logs, and monitors system operations and AI usage.")

System(traceLink, "TraceLink", "Automates bulk URL validation, webpage structure analysis, content fingerprinting, AI-assisted content evaluation, cache management, result review, and reporting.")

System_Ext(targetWebsites, "Target Websites", "External webpages accessed for URL validation and webpage-content analysis.")

System_Ext(aiService, "AI Service", "External AI provider used to evaluate accessible webpage content for relevance, quality, and spam-like indicators.")

' Layout helper
seoSpecialist -[hidden]down-> systemAdmin

' Two-way relationships
seoSpecialist <--> traceLink : Uploads URL batches and initiates scans;\nreceives progress, analysis results,\nreview information, and exports\n[HTTPS]

systemAdmin <--> traceLink : Manages users and monitors the platform;\nreceives integrity results, logs,\nalerts, and operational information\n[HTTPS]

traceLink <--> targetWebsites : Sends validation/content requests;\nreceives HTTP responses, redirects,\nerrors, and accessible webpage content\n[HTTPS]

traceLink <--> aiService : Sends prepared webpage content and criteria;\nreceives relevance, quality,\nspam-like indicators, and explanations\n[HTTPS / API]

SHOW_LEGEND()

@enduml